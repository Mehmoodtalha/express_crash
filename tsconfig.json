{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  "include": [
    "src/server.ts",
    "src/db/postgres.ts",
    "src/db/redis.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}